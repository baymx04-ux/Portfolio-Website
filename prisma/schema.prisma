generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id
  title       String
  slug        String   @unique
  description String
  techStack   String[]
  imageUrl    String
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  status      String   @default("published")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([status])
}