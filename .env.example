# Postgres connection string (Neon). Required by the app at runtime and by `prisma migrate dev` / seed.
# Copy .env.example to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Admin CMS passcode. Overrides the local fallback in src/app/api/auth/route.ts. Set a strong value.
ADMIN_PASSWORD=change-me

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=re_xxxx

# Contact form email routing (optional overrides; defaults shown).
# In production override CONTACT_FROM_EMAIL once your domain is verified on Resend
# (development default: onboarding@resend.dev).
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=junaidkanwar04@gmail.com